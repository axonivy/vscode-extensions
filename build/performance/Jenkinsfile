pipeline {
  agent {
    label 'windows-vscode'
  }

  tools {
    jdk 'temurin-jdk-25.0.4.1.1'
    maven '3.9'
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '60', artifactNumToKeepStr: '2'))
    disableConcurrentBuilds()
  }

  triggers {
    cron '@midnight'
  }

  environment {
    CI = 'true'
  }

  stages {

    stage('Build') {
      steps {
        nodejs(nodeJSInstallationName: '24.18.0') {
          bat 'pnpm install'
          bat 'pnpm run update:axonivy:next'
          bat 'pnpm run build:production'
        }
        script {
          bat 'git clone https://github.com/axonivy-market/portal.git playwright/tests/workspaces/portalPerformance/portal || exit /b 0'
          bat 'git -C playwright/tests/workspaces/portalPerformance/portal clean -fdx'
          bat 'git -C playwright/tests/workspaces/portalPerformance/portal checkout master'
          bat 'git -C playwright/tests/workspaces/portalPerformance/portal pull'
        }
      }
    }

    stage('Playwright Performance Tests') {
      steps {
        nodejs(nodeJSInstallationName: '24.18.0') {
          catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
            bat 'pnpm run test:playwright:performance'
          }
          powershell returnStatus: true, script: '''
            $ws = Get-ChildItem $env:TEMP -Directory -Filter 'portalPerformance*' | Sort-Object LastWriteTime | Select-Object -Last 1
            Write-Output "[diag] workspace: $($ws.FullName)"
            Get-ChildItem -Path $ws.FullName -Recurse -Directory -Filter 'mvn-deps' | ForEach-Object {
              Write-Output "[diag] $($_.FullName) created=$($_.CreationTime.ToString('HH:mm:ss.fff'))"
              Get-ChildItem $_.FullName | ForEach-Object { Write-Output "[diag]   $($_.Name) created=$($_.CreationTime.ToString('HH:mm:ss.fff')) written=$($_.LastWriteTime.ToString('HH:mm:ss.fff'))" }
            }
          '''
          archiveArtifacts artifacts: 'playwright/test-results/**', allowEmptyArchive: true
          archiveArtifacts artifacts: 'playwright/test-user-data-dir/logs/**', allowEmptyArchive: true
          archiveArtifacts artifacts: 'playwright/test-user-data-dir/User/globalStorage/axonivy.vscode-designer*/engines/*_All_*/logs/**', allowEmptyArchive: true
          withChecks('Performance Tests') {
            junit testDataPublishers: [[$class: 'StabilityTestDataPublisher']], testResults: 'node_modules/**/report.xml'
          }
        }
      }
    }
  }

  post {
    success {
      catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
        cleanWs()
      }
    }
  }
}
